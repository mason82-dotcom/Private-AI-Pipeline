[Unit]
Description=Private AI Light Console loopback proxy
Documentation=https://github.com/mason82-dotcom/Private-AI-Pipeline
Wants=docker.service
After=docker.service

[Service]
Type=simple
User=mason
ExecStart=/usr/local/libexec/private-ai-console-loopback
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
