# Automatically generated by scripts/init.sh, chmod 0600.
PIPELINE_TOKEN=GENERATE_ME
WEBUI_SECRET_KEY=GENERATE_ME
WEBUI_PORT=38880
# First boot: create first admin account locally, then set false and restart.
ENABLE_SIGNUP=true
# Internal isolated inference: http://ollama:11434
# LAN inference requires compose.lan.yaml AND host-side egress firewall rules.
OLLAMA_URL=http://ollama:11434
DEFAULT_MODEL=qwen3:1.7b
# Safe defaults: no memory auto-injection and agent cannot modify memory.
MEMORY_INJECTION=false
WEBUI_MEMORY_NAMESPACE=webui
MCP_MEMORY_NAMESPACE=personal
MCP_READONLY=true
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:slim
OLLAMA_IMAGE=ollama/ollama:latest

# Optional Light Console (independent sign-in; no browser API token)
CONSOLE_PORT=38881
CONSOLE_PASSWORD_HASH=GENERATE_ME
# Set true when serving only through HTTPS reverse proxy; false for local HTTP loopback.
CONSOLE_SECURE_COOKIE=false

# P2 single-operator knowledge. Separate capability token, never sent to browser.
KNOWLEDGE_TOKEN=GENERATE_ME
KNOWLEDGE_NAMESPACE=personal
# Opt-in: only .md/.txt/.rst UTF-8, <=48 KiB per file.
KNOWLEDGE_IMPORT_ENABLED=false
